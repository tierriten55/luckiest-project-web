---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import BodegaSeccion from '../components/BodegaSeccion.astro';
import sitio from '../data/sitio.json';
import { bodegas, esPlaceholder } from '../lib/vinos';
---

<Base>
  <Hero />

  {bodegas.map((b, i) => <BodegaSeccion bodega={b} numero={i + 1} />)}

  <section class="section nosotros" id="nosotros">
    <div class="container angosto">
      <header class="section-head" data-reveal>
        <p class="eyebrow">Quiénes somos</p>
        <h2 class="section-title">{sitio.nosotros.titulo}</h2>
        <hr class="rule" />
      </header>
      <div class="texto">
        {sitio.nosotros.parrafos.map((p) => (
          <p class:list={{ placeholder: esPlaceholder(p) }} data-reveal>{p}</p>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .nosotros { border-top: 1px solid var(--line); }
  .angosto { max-width: 760px; }
  .texto {
    display: grid;
    gap: 1.4rem;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-soft);
  }
</style>
