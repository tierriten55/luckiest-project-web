---
// Placeholder elegante (3:4) mientras no haya foto: silueta de botella + nombre del vino.
interface Props {
  nombre: string;
  slug: string;
}
const { nombre, slug } = Astro.props;

// Parte el nombre en hasta 2 líneas de ~20 caracteres.
function partir(texto: string, max = 20): string[] {
  const lineas: string[] = [];
  let actual = '';
  for (const palabra of texto.split(/\s+/)) {
    if (actual && (actual + ' ' + palabra).length > max) {
      lineas.push(actual);
      actual = palabra;
    } else {
      actual = actual ? `${actual} ${palabra}` : palabra;
    }
  }
  if (actual) lineas.push(actual);
  if (lineas.length > 2) return [lineas[0], lineas.slice(1).join(' ')];
  return lineas;
}

const lineas = partir(nombre);
const id = `b-${slug}`;
const yBase = lineas.length > 1 ? 350 : 362;
---

<svg
  class="botella"
  viewBox="0 0 300 400"
  preserveAspectRatio="xMidYMid meet"
  role="img"
  aria-label={`${nombre} (foto próximamente)`}
>
  <defs>
    <radialGradient id={`${id}-halo`} cx="50%" cy="42%" r="60%">
      <stop offset="0%" stop-color="#2a221e" />
      <stop offset="100%" stop-color="#1b1715" />
    </radialGradient>
    <linearGradient id={`${id}-vidrio`} x1="0" x2="1" y1="0" y2="0">
      <stop offset="0%" stop-color="#1c0f12" />
      <stop offset="30%" stop-color="#3a1820" />
      <stop offset="42%" stop-color="#5a2530" />
      <stop offset="55%" stop-color="#34161c" />
      <stop offset="100%" stop-color="#140a0c" />
    </linearGradient>
  </defs>

  <rect width="300" height="400" fill={`url(#${id}-halo)`} />

  <g transform="translate(0 -12)">
    <!-- sombra -->
    <ellipse cx="150" cy="316" rx="46" ry="5" fill="#000" opacity="0.35" />
    <!-- botella -->
    <path
      d="M140 44 L140 104 C140 122 119 130 119 152 L119 304 Q119 313 128 313 L172 313 Q181 313 181 304 L181 152 C181 130 160 122 160 104 L160 44 Z"
      fill={`url(#${id}-vidrio)`}
    />
    <!-- cápsula -->
    <rect x="138" y="36" width="24" height="44" rx="2.5" fill="#2a1216" />
    <rect x="138" y="76" width="24" height="1.2" fill="#8e2a3a" opacity="0.7" />
    <!-- brillo -->
    <path d="M129 160 L129 296" stroke="#eee4d3" stroke-width="2" stroke-linecap="round" opacity="0.08" />
    <!-- etiqueta -->
    <rect x="125" y="200" width="50" height="66" rx="1.5" fill="#eee4d3" opacity="0.88" />
    <rect x="129" y="204" width="42" height="58" fill="none" stroke="#13100e" stroke-width="0.6" opacity="0.5" />
    <text
      x="150" y="238"
      text-anchor="middle"
      font-family="Cormorant Garamond, serif"
      font-size="17"
      font-style="italic"
      fill="#13100e"
    >LP</text>
    <rect x="143" y="245" width="14" height="0.8" fill="#8e2a3a" />
  </g>

  <text
    text-anchor="middle"
    font-family="Cormorant Garamond, serif"
    font-size="21"
    fill="#eee4d3"
    letter-spacing="0.3"
  >
    {lineas.map((l, i) => (
      <tspan x="150" y={yBase + i * 24}>{l}</tspan>
    ))}
  </text>
</svg>

<style>
  .botella { width: 100%; height: 100%; }
</style>
