---
import sitio from '../data/sitio.json';
import { esPlaceholder } from '../lib/vinos';
const frase = sitio.hero.frase;
---

<section class="hero">
  <div class="container inner">
    <p class="eyebrow" data-reveal>Catálogo de vinos</p>
    <h1 class="titulo" data-reveal>{sitio.marca}</h1>
    <hr class="rule" data-reveal />
    <p class:list={['frase', { placeholder: esPlaceholder(frase) }]} data-reveal>{frase}</p>
    <a href="#recomendados" class="cta eyebrow" data-reveal>
      Ver catálogo
      <svg viewBox="0 0 12 20" width="10" height="16" aria-hidden="true"><path d="M6 1v17M1 13l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1" /></svg>
    </a>
  </div>
</section>

<style>
  .hero {
    min-height: calc(88svh - var(--nav-h));
    display: grid;
    place-items: center;
    text-align: center;
    padding-block: 5rem;
    background:
      radial-gradient(ellipse 60% 50% at 50% 45%, rgba(142, 42, 58, 0.10), transparent 70%);
  }
  .inner {
    display: grid;
    justify-items: center;
    gap: 1.6rem;
  }
  .titulo {
    font-size: clamp(3.2rem, 13vw, 7.5rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.005em;
  }
  .frase {
    max-width: 34ch;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 3.6vw, 1.6rem);
    font-style: italic;
    line-height: 1.4;
    color: var(--text-soft);
  }
  .frase.placeholder { color: var(--text-faint); }
  .cta {
    margin-top: 2rem;
    display: inline-grid;
    justify-items: center;
    gap: 0.7rem;
    transition: color 0.3s var(--ease);
  }
  .cta:hover { color: var(--text); }
  .cta svg { transition: transform 0.5s var(--ease); }
  .cta:hover svg { transform: translateY(4px); }

  .inner > :nth-child(2) { transition-delay: 0.08s; }
  .inner > :nth-child(3) { transition-delay: 0.16s; }
  .inner > :nth-child(4) { transition-delay: 0.24s; }
  .inner > :nth-child(5) { transition-delay: 0.36s; }
</style>
