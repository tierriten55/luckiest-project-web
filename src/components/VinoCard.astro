---
import VinoImagen from './VinoImagen.astro';
import { formatearPrecio, type Vino } from '../lib/vinos';

interface Props {
  vino: Vino;
}
const { vino } = Astro.props;
const precio = formatearPrecio(vino.precio);
const detalle = [vino.cepa, vino.anio].filter(Boolean).join(' · ');
---

<li class="card" data-reveal>
  <a href={`/vinos/${vino.slug}`} class="link">
    <div class="imagen"><VinoImagen vino={vino} /></div>
    <div class="texto">
      <p class:list={['eyebrow', 'detalle', { vacio: !detalle }]} aria-hidden={!detalle ? 'true' : undefined}>{detalle || '\u00a0'}</p>
      <h3 class="nombre">{vino.nombre}</h3>
      <p class:list={['precio', { pendiente: vino.precio == null }]}>{precio}</p>
      <span class="ver eyebrow" aria-hidden="true">
        Ver ficha
        <svg viewBox="0 0 20 12" width="16" height="10"><path d="M1 6h17M13 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1" /></svg>
      </span>
    </div>
  </a>
</li>

<style>
  /* mobile: tarjeta horizontal */
  .link {
    display: grid;
    grid-template-columns: 40% 1fr;
    align-items: center;
    gap: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .card:last-child .link { border-bottom: 0; padding-bottom: 0; }

  .imagen :global(.marco > *) { will-change: transform; }
  .link:hover .imagen :global(.marco > *) { transform: scale(1.035); }

  .texto {
    display: grid;
    gap: 0.5rem;
    align-content: center;
  }
  .detalle { font-size: 0.62rem; }
  .detalle.vacio { display: none; }
  .nombre {
    font-size: 1.45rem;
    font-weight: 500;
    line-height: 1.12;
    transition: color 0.35s var(--ease);
  }
  .link:hover .nombre { color: #fff7ea; }
  .precio {
    font-size: 1rem;
    font-weight: 450;
    letter-spacing: 0.02em;
  }
  .precio.pendiente {
    font-size: 0.8rem;
    color: var(--text-faint);
    font-style: italic;
  }
  .ver {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
    font-size: 0.6rem;
    color: var(--text-faint);
    transition: color 0.3s var(--ease);
  }
  .ver svg { transition: transform 0.4s var(--ease); }
  .link:hover .ver { color: var(--accent-soft); }
  .link:hover .ver svg { transform: translateX(4px); }

  /* tablet / desktop: tarjeta vertical */
  @media (min-width: 720px) {
    .link {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.4rem;
      padding-bottom: 0;
      border-bottom: 0;
    }
    .texto {
      gap: 0.45rem;
      justify-items: center;
      text-align: center;
    }
    .nombre { font-size: clamp(1.35rem, 2.2vw, 1.65rem); }
    /* sin cepa: se reserva el renglón para que los nombres queden alineados */
    .detalle.vacio { display: block; visibility: hidden; }
    .ver { margin-top: 0.4rem; }
  }
</style>
